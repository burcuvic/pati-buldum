rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pets/{petId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'contactPhone', 'status', 'species', 'name',
          'color', 'notes', 'area', 'lat', 'lng', 'photo', 'photos',
          'thumbnail', 'lostDate', 'reward', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 70
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.area is string
        && request.resource.data.area.size() <= 120
        && request.resource.data.species in ['Kedi', 'Köpek']
        && request.resource.data.status in ['Kayıp', 'Bulundu']
        && (!('photos' in request.resource.data)
          || (request.resource.data.photos is list
            && request.resource.data.photos.size() <= 6))
        && (!('lostDate' in request.resource.data)
          || (request.resource.data.lostDate is string
            && request.resource.data.lostDate.size() <= 10))
        && (!('reward' in request.resource.data)
          || (request.resource.data.reward is number
            && request.resource.data.reward >= 0
            && request.resource.data.reward <= 10000000))
        && (!('contactPhone' in request.resource.data)
          || (request.resource.data.contactPhone is string
            && request.resource.data.contactPhone.size() <= 20
            && (request.resource.data.contactPhone == ''
              || request.resource.data.contactPhone.matches('^[+0-9() .-]{7,20}$'))));

      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }


    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName','bio','joinedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 70
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','bio'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 70
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300;
      allow delete: if false;

      match /friends/{friendUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid == friendUid
          && request.resource.data.keys().hasOnly(['uid','addedAt'])
          && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + friendUid))
          && get(/databases/$(database)/documents/friendRequests/$(uid + '_' + friendUid)).data.status == 'accepted';
        allow update, delete: if false;
      }
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['senderUid','recipientUid','status','createdAt'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && requestId == request.resource.data.recipientUid + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUid));
      allow update: if request.auth != null
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted','rejected'];
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      function participant() {
        return request.auth != null
          && request.auth.uid in resource.data.participants;
      }

      allow read: if participant();

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'petId', 'petName', 'ownerUid', 'senderUid', 'participants', 'createdAt'
        ])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.petId is string
        && request.resource.data.petName is string
        && request.resource.data.petName.size() <= 70
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.participants == [
          request.resource.data.ownerUid, request.auth.uid
        ]
        && conversationId == request.resource.data.petId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/pets/$(request.resource.data.petId))
        && get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.ownerUid
          == request.resource.data.ownerUid;

      allow update, delete: if false;

      match /messages/{messageId} {
        function member() {
          return request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants;
        }

        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly([
            'senderUid', 'text', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }
  }
}
